{
  "name": "fabricator-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for Fabricator, a desktop workbench for building Rayfin apps with GitHub Copilot and Microsoft Fabric.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "build": "next build && npm run emit:agent",
    "preview": "node scripts/serve-pages.mjs",
    "emit:agent": "tsx scripts/emit-agent-assets.mts",
    "verify:agent": "tsx scripts/verify-agent-assets.mts",
    "verify:app-links": "tsx scripts/verify-app-links.mts",
    "check:docs": "tsx scripts/check-docs.mts",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.15.0",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.0",
    "mermaid": "11.17.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
